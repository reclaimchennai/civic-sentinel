# =============================================================================
# Chennai Civic Sentinel - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# See docs/AUTH_SETUP.md for step-by-step instructions on obtaining each key.
# =============================================================================

# --- Auth.js (NextAuth v5) ---------------------------------------------------
# Required: Secret for signing JWTs. Generate with: npx auth secret
AUTH_SECRET=

# App URL (set to your deployment URL in production)
AUTH_URL=http://localhost:3000

# --- OAuth Providers ---------------------------------------------------------
# See docs/AUTH_SETUP.md for how to obtain these credentials.
# Only configure the providers you want to enable.

# Google (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Twitter / X (https://developer.x.com/en/portal/dashboard)
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Facebook (https://developers.facebook.com/apps)
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Apple (https://developer.apple.com/account/resources/identifiers)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Reddit (https://www.reddit.com/prefs/apps)
AUTH_REDDIT_ID=
AUTH_REDDIT_SECRET=

# --- Backend Services --------------------------------------------------------

# LocationIQ (https://locationiq.com/) - Used for reverse geocoding
LOCATIONIQ_API_KEY=

# --- PostgreSQL (defaults match docker-compose.yml) --------------------------
# Used by the FastAPI backend running INSIDE the docker network.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chennai_sentinel
POSTGRES_HOST=db

# DATABASE_URL is used by the Next.js app running on the HOST machine.
# Note the host port (5455) — that's the external port mapped in docker-compose.yml.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5455/chennai_sentinel

# --- MinIO (defaults match docker-compose.yml) -------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
